<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AssemblyName>Gudel.GLogWare.$(MSBuildProjectName)</AssemblyName>
		<RootNamespace>Gudel.GLogWare.$(MSBuildProjectName)</RootNamespace>
		<AssemblyTitle>Gudel.GLogWare.$(MSBuildProjectName)</AssemblyTitle>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
	  <DefineConstants>$(DefineConstants);SQLSERVER</DefineConstants>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
	  <DefineConstants>$(DefineConstants);SQLSERVER</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\EFCore.Domain\EFCore.Domain.csproj" />
		<ProjectReference Include="..\Shared\Shared.csproj" />
	</ItemGroup>
	
	<ItemGroup>
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
	</ItemGroup>

	
	<ItemGroup Condition="$(DefineConstants.Contains('SQLSERVER'))">
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.11" />
	</ItemGroup>
	<ItemGroup Condition="$(DefineConstants.Contains('ORACLE'))">
		<PackageReference Include="Oracle.EntityFrameworkCore" Version="10.23.26300" />
	</ItemGroup>
	<ItemGroup Condition="$(DefineConstants.Contains('POSTGRES'))">
		<PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
	</ItemGroup>
	<ItemGroup Condition="$(DefineConstants.Contains('MYSQL'))">
		<PackageReference Include="MySql.EntityFrameworkCore" Version="10.0.7" />
	</ItemGroup>
	
</Project>
