<EditForm Model="@comp" OnValidSubmit="() => SendToGLogWare()">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="form-grid">

        <table width="100%">
            <tr>
                <td align="right">
                    Job-Id:
                </td>
                <td align="left">
                    <InputText @bind-Value="comp.Jobid"
                               style="width: 100px" />
                </td>
            </tr>
            <tr>
                <td align="right">Feedback Code:</td>
                <td align="left">
                    <InputSelect @bind-Value="comp.FeedbackCode">
                        <option value="0000">OK</option>
                        <option value="0001">Bridge not in Automatic</option>
                        <option value="0002">Job still active</option>
                        <option value="0003">Wrong data</option>
                        <option value="0011">Order not executable</option>
                    </InputSelect>
                </td>
            </tr>
            <tr>
                <td align="right">Execution time:</td>
                <td align="left">
                    <InputSelect @bind-Value="SelectedExecutionValue">
                        <option value="0">Manually sent</option>
                        <option value="1000">1 second</option>
                        <option value="3000">3 seconds</option>
                        <option value="7000">7 seconds</option>
                        <option value="15000">15 seconds</option>
                    </InputSelect>
                </td>
            </tr>
        </table>
    </div>

    <br />

    <button type="submit" disabled="@isCompSendButtonDisabled">Send</button>
</EditForm>


@code {
    [Parameter]
    public string? bridgeOP { get; set; }

    private COMP comp = null!;
    private BridgeConfiguration bridgeConfiguration = null!;
    private bool isCompSendButtonDisabled = false;
    private string _selectedExecutionValue = "0";
    private string SelectedExecutionValue
    {
        get => _selectedExecutionValue;
        set
        {
            if (_selectedExecutionValue != value)
            {
                _selectedExecutionValue = value;

                // fire-and-forget async call
                _ = OnExecutionTimeChangedAsync(value);
            }
        }
    }

    override protected void OnInitialized()
    {
        comp = new COMP()
        {
            Jobid = "Job-Id",
            FeedbackCode = "0000"
        };
        bridgeConfiguration = new BridgeConfiguration()
        {
            DelaySendCOMP = 0
        };
    }

    private async Task SendToGLogWare()
    {
        string topic = $"GantryBridges/{bridgeOP}/Simulation/Incoming";
        GLogWareMessage m = new GLogWareMessage();
        m.Identifier = GLogWareMessageIdentifiers.ToGLogWare;

        PlcMessage pm = new PlcMessage();
        pm.Identifier = PlcMessageIdentifiers.COMP;
        pm.Sender = bridgeOP!;
        pm.Receiver = "GLOGWARE";
        pm.Data = comp;
        m.Data = pm;

        await MqttService.SendMessage(topic, m);
    }

    private async Task OnExecutionTimeChangedAsync(string value)
    {
        bridgeConfiguration.DelaySendCOMP = int.Parse(value);
        isCompSendButtonDisabled = (bridgeConfiguration.DelaySendCOMP != 0);
        await SendConfiguration();
    }

    private async Task SendConfiguration()
    {
        string topic = $"GantryBridges/{bridgeOP}/Simulation/Incoming";
        GLogWareMessage m = new GLogWareMessage();
        m.Identifier = GLogWareMessageIdentifiers.Configuration;
        m.Data = bridgeConfiguration;
        
        await MqttService.SendMessage(topic, m);
    }
}
