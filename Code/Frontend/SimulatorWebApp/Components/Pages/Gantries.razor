@page "/gantries"
@rendermode InteractiveServer

<h3>Gantries</h3>
<br />

<table>
<tr>
    <td>Bridge:</td>
    <td>
        <InputSelect @bind-Value="bridgeOP">
            <option value="OP7100BR">OP7100BR</option>
            <option value="OP7200BR">OP7200BR</option>
        </InputSelect>
    </td>
    <td width="50px"></td>
    <td>
        <InputRadioGroup @bind-Value="direction">
            <label style="margin-right:30px;">
                <InputRadio Value="Direction.FromPlc" /> From Plc
            </label>
            <label>
                <InputRadio Value="Direction.ToPlc" /> To Plc
            </label>
        </InputRadioGroup>
    </td>
</tr>
</table>

<br />

@if (direction == Direction.FromPlc)
{
    <div class="tab-container">
        <div class="tab-header">
            <button class="tab @(activeTabFromPlc == 0 ? "active" : "")" @onclick="() => SetTabFromPlc(0)">STAT</button>
            <button class="tab @(activeTabFromPlc == 1 ? "active" : "")" @onclick="() => SetTabFromPlc(1)">COMP</button>
        </div>

        <div class="tab-content">
            @if (activeTabFromPlc == 0)
            {
                <EditForm Model="@stat" OnValidSubmit="() => SendToGLogWare(PlcMessageIdentifiers.STAT)">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="form-grid">

                        <table width="100%">
                            <tr>
                                <td align="right">Parked:</td>
                                <td align="left"><InputCheckbox @bind-Value="stat.Parked" /></td>
                            </tr>
                            <tr>
                                <td align="right">Working Mode:</td>
                                <td align="left">
                                    <InputSelect @bind-Value="stat.WorkingMode">
                                        <option value="AUTOMATIC">Automatic</option>
                                        <option value="MANUAL">Manual</option>
                                        <option value="STOPPED">Stopped</option>
                                    </InputSelect>
                                </td>
                            </tr>
                            <tr>
                                <td align="right">Gripper Occupied:</td>
                                <td align="left"><InputCheckbox @bind-Value="stat.GripperOccupied" /></td>
                            </tr>
                            <tr>
                                <td align="right">ErrorFlag:</td>
                                <td align="left"><InputCheckbox @bind-Value="stat.ErrorFlag" /></td>
                            </tr>
                        </table>

                    </div>

                    <br />

                    <button type="submit">Send</button>
                </EditForm>
            }
            else if (activeTabFromPlc == 1)
            {
                <EditForm Model="@stat" OnValidSubmit="() => SendToGLogWare(PlcMessageIdentifiers.COMP)">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="form-grid">

                        <table width="100%">
                            <tr>
                                <td align="right">
                                    Job-Id:
                                </td>
                                <td align="left">
                                    <InputText @bind-Value="comp.Jobid"
                                               style="width: 100px" />
                                </td>
                            </tr>
                            <tr>
                                <td align="right">Feedback Code:</td>
                                <td align="left">
                                    <InputSelect @bind-Value="comp.FeedbackCode">
                                        <option value="0000">OK</option>
                                        <option value="0001">Bridge not in Automatic</option>
                                        <option value="0002">Job still active</option>
                                        <option value="0003">Wrong data</option>
                                        <option value="0011">Order not executable</option>
                                    </InputSelect>
                                </td>
                            </tr>
                            <tr>
                                <td align="right">Execution time:</td>
                                <td align="left">
                                    <InputSelect @bind-Value="SelectedExecutionValue">
                                        <option value="0">Manually sent</option>
                                        <option value="1000">1 second</option>
                                        <option value="3000">3 seconds</option>
                                        <option value="7000">7 seconds</option>
                                        <option value="15000">15 seconds</option>
                                    </InputSelect>
                                </td>
                            </tr>
                        </table>
                    </div>

                    <br />

                    <button type="submit" disabled="@isCompSendButtonDisabled">Send</button>
                </EditForm>
            }
        </div>
    </div>
}
else
{
    <div class="tab-container">
        <div class="tab-header">
            <button class="tab @(activeTabToPlc == 0 ? "active" : "")" @onclick="() => SetTabToPlc(0)">ORDS</button>
            <button class="tab @(activeTabToPlc == 1 ? "active" : "")" @onclick="() => SetTabToPlc(1)">DELT</button>
        </div>

        <div class="tab-content">
            @if (activeTabToPlc == 0)
            {
                <EditForm Model="@stat" OnValidSubmit="() => SendToPlc(PlcMessageIdentifiers.ORDS)">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="form-grid">

                        <table width="100%">
                            <tr>
                                <td align="right">
                                    Job-Id:
                                </td>
                                <td align="right">
                                    <InputText @bind-Value="ords.Jobid"
                                               style="width: 100px" />
                                </td>
                                <td width="50px"></td>
                                <td align="right">
                                    Inner ⌀:
                                </td>
                                <td align="right">
                                    <InputNumber @bind-Value="ords.InnerDiameter"
                                                 max="9999" style="width: 80px" />
                                </td>
                            </tr>
                            <tr>
                                <td align="right">
                                    Article:
                                </td>
                                <td align="right">
                                    <InputText @bind-Value="ords.Article"
                                               style="width: 100px" />
                                </td>
                                <td width="50px"></td>
                                <td align="right">
                                    Outer ⌀:
                                </td>
                                <td align="right">
                                    <InputNumber @bind-Value="ords.OuterDiameter"
                                                 max="9999" style="width: 80px" />
                                </td>
                            </tr>
                            <tr>
                                <td align="right">
                                    Order:
                                </td>
                                <td align="right">
                                    <InputText @bind-Value="ords.Order"
                                               style="width: 100px" />
                                </td>
                                <td width="50px"></td>
                                <td align="right">
                                    Width:
                                </td>
                                <td align="right">
                                    <InputNumber @bind-Value="ords.Width"
                                                 max="9999" style="width: 80px" />
                                </td>
                            </tr>
                            <tr>
                                <td align="right">
                                    TireCount:
                                </td>
                                <td align="right">
                                    <InputNumber @bind-Value="ords.TireCount"
                                                 max="20" style="width: 40px" />
                                </td>
                                <td width="50px"></td>
                                <td colspan="2"></td>
                            </tr>
                            <tr style="height: 30px;">
                                <td colspan="5"></td>
                            </tr>
                            <tr>
                                <td align="center" colspan="2">
                                    <b>Pick Position</b>
                                </td>
                                <td width="50px"></td>
                                <td align="center" colspan="2">
                                    <b>Drop Position</b>
                                </td>
                            </tr>
                            <tr>
                                <td align="right">
                                    PosType:
                                </td>
                                <td align="right">
                                    <InputSelect @bind-Value="ords.PickPosition.PositionType">
                                        <option value="Undefined">Undefined</option>
                                        <option value="Conveyor">Conveyor</option>
                                        <option value="Store">Store</option>
                                        <option value="Pallet">Pallet</option>
                                    </InputSelect>
                                </td>
                                <td width="50px"></td>
                                <td align="right">
                                    PosType:
                                </td>
                                <td align="right">
                                    <InputSelect @bind-Value="ords.DropPosition.PositionType">
                                        <option value="Undefined">Undefined</option>
                                        <option value="Conveyor">Conveyor</option>
                                        <option value="Store">Store</option>
                                        <option value="Pallet">Pallet</option>
                                    </InputSelect>
                                </td>
                            </tr>
                            <tr>
                                <td align="right">
                                    Conveyor:
                                </td>
                                <td align="right">
                                    <InputText @bind-Value="ords.PickPosition.ConveyorPlace"
                                    style="width: 50px" />
                                </td>
                                <td width="50px"></td>
                                <td align="right">
                                    Conveyor:
                                </td>
                                <td align="right">
                                    <InputText @bind-Value="ords.DropPosition.ConveyorPlace"
                                    style="width: 50px" />
                                </td>
                            </tr>
                            <tr>
                                <td align="right">
                                    XCell:
                                </td>
                                <td align="right">
                                    <InputNumber @bind-Value="ords.PickPosition.XCell" 
                                    max="73" style="width: 40px" />
                                </td>
                                <td width="50px"></td>
                                <td align="right">
                                    XCell:
                                </td>
                                <td align="right">
                                    <InputNumber @bind-Value="ords.DropPosition.XCell" 
                                    max="73" style="width: 40px" />
                                </td>
                            </tr>
                            <tr>
                                <td align="right">
                                    YCell:
                                </td>
                                <td align="right">
                                    <InputNumber @bind-Value="ords.PickPosition.YCell" 
                                    max="17" style="width: 40px" />
                                </td>
                                <td width="50px"></td>
                                <td align="right">
                                    YCell:
                                </td>
                                <td align="right">
                                    <InputNumber @bind-Value="ords.DropPosition.YCell" 
                                    max="17" style="width: 40px" />
                                </td>
                            </tr>
                            <tr>
                                <td align="right">
                                    XPos:
                                </td>
                                <td align="right">
                                    <InputNumber @bind-Value="ords.PickPosition.XPosition"
                                    max="999999" style="width: 80px" />
                                </td>
                                <td width="50px"></td>
                                <td align="right">
                                    XPos:
                                </td>
                                <td align="right">
                                    <InputNumber @bind-Value="ords.DropPosition.XPosition"
                                    max="999999" style="width: 80px" />
                                </td>
                            </tr>
                            <tr>
                                <td align="right">
                                    YPos:
                                </td>
                                <td align="right">
                                    <InputNumber @bind-Value="ords.PickPosition.YPosition"
                                    max="999999" style="width: 80px" />
                                </td>
                                <td width="50px"></td>
                                <td align="right">
                                    YPos:
                                </td>
                                <td align="right">
                                    <InputNumber @bind-Value="ords.DropPosition.YPosition"
                                    max="999999" style="width: 80px" />
                                </td>
                            </tr>
                            <tr>
                                <td align="right">
                                    ZOffset:
                                </td>
                                <td align="right">
                                    <InputNumber @bind-Value="ords.PickPosition.ZOffset"
                                    max="999999" style="width: 80px" />
                                </td>
                                <td width="50px"></td>
                                <td align="right">
                                    ZOffset:
                                </td>
                                <td align="right">
                                    <InputNumber @bind-Value="ords.DropPosition.ZOffset"
                                    max="999999" style="width: 80px" />
                                </td>
                            </tr>
                        </table>

                    </div>

                    <br />

                    <button type="submit">Send</button>
                </EditForm>
            }
            else if (activeTabToPlc == 1)
            {
                <p>Content for DELT</p>
            }
        </div>
    </div>
}

@code {
    public enum Direction
    {
        FromPlc,
        ToPlc
    }

    private string _selectedExecutionValue = "0";
    private string SelectedExecutionValue
    {
        get => _selectedExecutionValue;
        set
        {
            if (_selectedExecutionValue != value)
            {
                _selectedExecutionValue = value;

                // fire-and-forget async call
                _ = OnExecutionTimeChangedAsync(value);
            }
        }
    }

    private int activeTabFromPlc = 0;
    private int activeTabToPlc = 0;
    private string bridgeOP = "OP7100BR";
    private Direction direction = Direction.FromPlc;
    private STATBridge stat = null!;
    private COMP comp = null!;
    private ORDS ords = null!;
    private BridgeConfiguration bridgeConfiguration = null!;
    private bool isCompSendButtonDisabled = false;

    override protected void OnInitialized()
    {
        stat = new STATBridge();
        comp = new COMP() {
            Jobid = "Job-Id",
            FeedbackCode = "0000"
        };
        bridgeConfiguration = new BridgeConfiguration(){
                DelaySendCOMP = 0
        };

        ords = new ORDS() {
            Jobid = "Job-Id",
            Article = "ArticleNr",
            Order = "OrderNr",
            InnerDiameter = 760,
            OuterDiameter = 830,
            Width = 210,
            TireCount = 3
        };
        ords.PickPosition = new ORDSPosition()
        {
            PositionType = ORDSPositionTypes.Conveyor,
            ConveyorPlace = "1340",
            XCell = 0, YCell = 0,
            XPosition = 0, YPosition = 0,
            ZOffset = 0
        };
        ords.DropPosition = new ORDSPosition()
        {
            PositionType = ORDSPositionTypes.Store,
            ConveyorPlace = "0000",
            XCell = 47,
            YCell = 3,
            XPosition = 54321,
            YPosition = 2345,
            ZOffset = 4567
        };
    }

    private async Task OnExecutionTimeChangedAsync(string value)
    {
        bridgeConfiguration.DelaySendCOMP = int.Parse(value);
        isCompSendButtonDisabled = (bridgeConfiguration.DelaySendCOMP != 0);
        await SendConfiguration();
    }

    private async Task SetTabFromPlc(int index) => activeTabFromPlc = index;

    private async Task SetTabToPlc(int index) => activeTabToPlc = index;

    private async Task SendToGLogWare(PlcMessageIdentifiers identifier)
    {
        string topic = $"GantryBridges/{bridgeOP}/Simulation/Incoming";
        GLogWareMessage m = new GLogWareMessage();
        m.Identifier = GLogWareMessageIdentifiers.ToGLogWare;

        PlcMessage pm = new PlcMessage();
        pm.Identifier = identifier;
        pm.Data = identifier switch
        {
            PlcMessageIdentifiers.STAT => stat,
            PlcMessageIdentifiers.COMP => comp,
            _ => null
        };
        m.Data = pm;

        await MqttService.SendMessage(topic, m);
    }

    private async Task SendToPlc(PlcMessageIdentifiers identifier)
    {
        string topic = $"GantryBridges/{bridgeOP}/Manager/Incoming";
        GLogWareMessage m = new GLogWareMessage();
        m.Identifier = GLogWareMessageIdentifiers.ToPlc;

        PlcMessage pm = new PlcMessage();
        pm.Identifier = identifier;
        pm.Data = identifier switch
        {
            PlcMessageIdentifiers.ORDS => ords,
            _ => null
        };
        m.Data = pm;

        await MqttService.SendMessage(topic, m);
    }

    private async Task SendConfiguration()
    {
        string topic = $"GantryBridges/{bridgeOP}/Simulation/Incoming";
        GLogWareMessage m = new GLogWareMessage();
        m.Identifier = GLogWareMessageIdentifiers.Configuration;
        m.Data = bridgeConfiguration;
        
        await MqttService.SendMessage(topic, m);
    }
}
