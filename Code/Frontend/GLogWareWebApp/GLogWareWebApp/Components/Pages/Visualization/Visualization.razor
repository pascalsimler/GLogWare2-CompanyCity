@page "/visualization"
@rendermode InteractiveServer

<h3>Visualization</h3>
<br /><br />

<div>
    <svg @ref="_svgRef" width="@SvgWidth" height="@SvgHeight" viewBox="0 0 @SvgWidth @SvgHeight">
        <rect x="0" y="0" width="@SvgWidth" height="@SvgHeight" rx="8" ry="8" fill="#f3f4f6" stroke="#d1d5db" />

        @foreach (var cell in _cells)
        {
            <GantryCell Cx="@cell.Cx"
                           Cy="@cell.Cy"
                           Radius="@Radius"
                           Number="@cell.Number"
                           Selected="@cell.Selected"
                           FontSize="@FontSize"
                           Zob="@cell.Zob"
                           OnToggle="@(() => Toggle(cell))" 
            />
        }
    </svg>

    @if (SelectedCells.Any())
    {
        <div class="selected-panel">
            <h3>Selected Cells (@SelectedCells.Count())</h3>
            <table class="selected-table">
                <thead>
                    <tr>
                        <th>Row</th>
                        <th>Col</th>
                        <th>Current Number</th>
                        <th>New Number</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cell in SelectedCells)
                    {
                        <tr>
                            <td>@cell.Row</td>
                            <td>@cell.Col</td>
                            <td>@cell.Number</td>
                            <td>
                                <input type="number" 
                                       min="1" 
                                       max="9" 
                                       @bind="cell.TempNumber" 
                                       class="number-input" />
                            </td>
                            <td>
                                <button @onclick="@(() => UpdateCellNumber(cell))" class="update-btn">
                                    Update
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="panel-actions">
                <button @onclick="UpdateAllSelected" class="update-all-btn">Update All</button>
                <button @onclick="ClearSelection" class="clear-btn">Clear Selection</button>
            </div>
        </div>
    }
</div>

