@rendermode InteractiveServer

<g transform="translate(@Cx, @Cy)"
   style="cursor:pointer"
   @onclick="OnClick">
    <path d="@RingPath"
          fill="@Fill"
          fill-rule="evenodd"
          stroke="@Stroke"
          stroke-width="1.2" />
    <text x="0"
          y="0"
          text-anchor="middle"
          dominant-baseline="central"
          font-family="Segoe UI, Arial"
          font-size="@FontSize">
        @Number
    </text>
</g>

@code {
    [Parameter] public double Cx { get; set; }
    [Parameter] public double Cy { get; set; }
    [Parameter] public double Radius { get; set; }
    [Parameter] public int Number { get; set; }
    [Parameter] public bool Selected { get; set; }
    [Parameter] public int FontSize { get; set; }
    [Parameter] public string? Zob { get; set; }

    [Parameter] public EventCallback OnToggle { get; set; }

    private string Fill => Selected ? "#ff7b7b" : Zob;
    private string Stroke => Selected ? "#b30000" : "#0366d6";

    private double Radius1;
    private double Radius2;

    private string RingPath => Recalculate();
   

    protected override void OnInitialized()
    {
        double min = 0.6 * Radius;
        double minWidth = 0.15 * Radius;

        Radius1 = min + (Radius - minWidth - min) * Random.Shared.NextDouble();
        Radius2 = Radius1 + minWidth + (Radius - Radius1 - minWidth) * Random.Shared.NextDouble();
    }

    private async Task OnClick()
    {
        if (OnToggle.HasDelegate)
        {
            await OnToggle.InvokeAsync();
        }
    }

    private string Recalculate()
{
    double min = 0.6 * Radius;
    double minWidth = 0.15 * Radius;

    Radius1 = min + (Radius - minWidth - min) * Random.Shared.NextDouble();
    Radius2 = Radius1 + minWidth + (Radius - Radius1 - minWidth) * Random.Shared.NextDouble();
    return FormattableString.Invariant(
        $"M {Radius2} 0 A {Radius2} {Radius2} 0 1 0 {-Radius2} 0 A {Radius2} {Radius2} 0 1 0 {Radius2} 0 Z M {Radius1} 0 A {Radius1} {Radius1} 0 1 0 {-Radius1} 0 A {Radius1} {Radius1} 0 1 0 {Radius1} 0 Z");
}

}
