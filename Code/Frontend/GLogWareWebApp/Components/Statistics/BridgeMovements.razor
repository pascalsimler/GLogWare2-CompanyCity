@page "/statistics/bridge-movements"
@inject ILogger<BridgeMovements> Logger
@inject GLogWareDbContext DbContext

<PageTitle>Bridge Movement Statistics</PageTitle>

<div class="page-heading scada-heading">
    <div style="width:450px">
        <MudText Typo="Typo.h4">Gantry bridge movements</MudText>
        <MudText Color="Color.Secondary">Number of bridge movements per gantry and @UnitName</MudText>
    </div>
    <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Spacing="3" Justify="Justify.FlexEnd">
        <div style="width:170px">
            <MudDatePicker T="DateTime?" Label="Start date" @bind-Date="_start" Variant="Variant.Outlined"
                           Margin="Margin.Dense" DateFormat="dd.MM.yyyy" MaxDate="_end" RelativeWidth="DropdownWidth.Ignore" />
        </div>
        <div style="width:170px">
            <MudDatePicker T="DateTime?" Label="End date" @bind-Date="_end" Variant="Variant.Outlined"
                           Margin="Margin.Dense" DateFormat="dd.MM.yyyy" MinDate="_start" RelativeWidth="DropdownWidth.Ignore" />
        </div>
        <MudPaper Outlined="true" Elevation="0" Class="px-3">
            <MudRadioGroup T="Granularity" @bind-Value="_granularity">
                <MudRadio T="Granularity" Value="Granularity.Hourly">Hourly</MudRadio>
                <MudRadio T="Granularity" Value="Granularity.Daily">Daily</MudRadio>
                <MudRadio T="Granularity" Value="Granularity.Weekly">Weekly</MudRadio>
                <MudRadio T="Granularity" Value="Granularity.Monthly">Monthly</MudRadio>
            </MudRadioGroup>
        </MudPaper>
        <MudCheckBox T="bool" @bind-Value="_allBridges" Label="All bridges" />
        <div style="flex-basis:100%"></div>
        <MudButton Variant="Variant.Outlined" Size="Size.Small" Disabled="_loading" OnClick="Refresh"
                   StartIcon="@(_loading ? null : Icons.Material.Filled.Refresh)">
            @if (_loading)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>Loading...</span>
            }
            else
            {
                <span>Refresh</span>
            }
        </MudButton>
        <CsvExportButton T="BridgeStatistic" FileName="BridgeStatisti" Items="@(() => _grid?.FilteredItems)" Columns="@_csvColumns" />
    </MudStack>
</div>

<MudPaper Elevation="0">
    <MudDataGrid T="BridgeStatistic" @ref="_grid" Class="grouped-header-grid" Items="@_rows" Loading="_loading" Dense="true" Hover="true" SortMode="SortMode.Multiple" Filterable="true" Hideable="false" FixedHeader="true" FixedFooter="true" Height="800px">
        <Header>
            <tr class="mud-table-row group-header-row">
                <th class="mud-table-cell" style="font-weight:bold" colspan="@(1 + (_showHour ? 1 : 0) + (_showBridge ? 1 : 0))">Key</th>
                <th class="mud-table-cell" style="font-weight:bold" colspan="4">Movements</th>
                <th class="mud-table-cell" style="font-weight:bold" colspan="4">Tires</th>
            </tr>
        </Header>
        <Columns>
            <PropertyColumn Property="x => x.Period" Title="Period" HeaderStyle="font-weight:bold" FooterStyle="font-weight:bold">
                <FooterTemplate>
                    @context.Items.Count() records
                </FooterTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.Hour" Title="Hour" Hidden="@(!_showHour)" HeaderStyle="font-weight:bold" FooterStyle="font-weight:bold" />
            <PropertyColumn Property="x => x.BridgeNr" Title="Bridge" Hidden="@(!_showBridge)" HeaderStyle="font-weight:bold" FooterStyle="font-weight:bold" />
            <PropertyColumn Property="x => x.CountOrdersIn" Title="In" CellStyle="text-align:right" HeaderStyle="text-align:right;font-weight:bold" FooterStyle="text-align:right;font-weight:bold">
                <FooterTemplate>
                    @context.Items.Sum(x => x.CountOrdersIn)
                </FooterTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.CountOrdersOut" Title="Out" CellStyle="text-align:right" HeaderStyle="text-align:right;font-weight:bold" FooterStyle="text-align:right;font-weight:bold"> 
                <FooterTemplate>
                    @context.Items.Sum(x => x.CountOrdersOut)
                </FooterTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.CountOrdersRelocation" Title="Relocation" CellStyle="text-align:right" HeaderStyle="text-align:right;font-weight:bold" FooterStyle="text-align:right;font-weight:bold">
                <FooterTemplate>
                    @context.Items.Sum(x => x.CountOrdersRelocation)
                </FooterTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.CountOrdersTotal" Title="Total" CellStyle="text-align:right" HeaderStyle="text-align:right;font-weight:bold" FooterStyle="text-align:right;font-weight:bold">
                <FooterTemplate>
                    @context.Items.Sum(x => x.CountOrdersTotal)
                </FooterTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.CountTiresIn" Title="In" CellStyle="text-align:right" HeaderStyle="text-align:right;font-weight:bold" FooterStyle="text-align:right;font-weight:bold">
                <FooterTemplate>
                    @context.Items.Sum(x => x.CountTiresIn)
                </FooterTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.CountTiresOut" Title="Out" CellStyle="text-align:right" HeaderStyle="text-align:right;font-weight:bold" FooterStyle="text-align:right;font-weight:bold"> 
                <FooterTemplate>
                    @context.Items.Sum(x => x.CountTiresOut)
                </FooterTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.CountTiresRelocation" Title="Relocation" CellStyle="text-align:right" HeaderStyle="text-align:right;font-weight:bold" FooterStyle="text-align:right;font-weight:bold">
                <FooterTemplate>
                    @context.Items.Sum(x => x.CountTiresRelocation)
                </FooterTemplate>   
            </PropertyColumn>
            <PropertyColumn Property="x => x.CountTiresTotal" Title="Total" CellStyle="text-align:right" HeaderStyle="text-align:right;font-weight:bold" FooterStyle="text-align:right;font-weight:bold"> 
                <FooterTemplate>
                    @context.Items.Sum(x => x.CountTiresTotal)
                </FooterTemplate>
            </PropertyColumn>
        </Columns>
    </MudDataGrid>
</MudPaper>
    

@code {
    private const int MaxRows = 1000;
    private MudDataGrid<BridgeStatistic>? _grid;
    private List<BridgeStatistic> _rows = new();
    private readonly IReadOnlyList<CsvExportButton<BridgeStatistic>.CsvColumn> _csvColumns =
    [
        new("BridgeNr", x => x.BridgeNr),
        new("Period", x => x.Period),
        new("Hour", x => x.Hour),
        new("CountOrdersIn", x => x.CountOrdersIn),
        new("CountOrdersOut", x => x.CountOrdersOut),
        new("CountOrdersRelocation", x => x.CountOrdersRelocation),
        new("CountOrdersTotal", x => x.CountOrdersTotal),
        new("CountTiresIn", x => x.CountTiresIn),
        new("CountTiresOut", x => x.CountTiresOut),
        new("CountTiresRelocation", x => x.CountTiresRelocation),
        new("CountTiresTotal", x => x.CountTiresTotal)
    ];
    private DateTime? _start = DateTime.Today.AddDays(-6);
    private DateTime? _end = DateTime.Today;
    private enum Granularity { Hourly, Daily, Weekly, Monthly }
    private Granularity _granularity = Granularity.Daily;
    private bool _allBridges = true;
    private bool _showHour;
    private bool _showBridge;
    private string UnitName => _granularity.ToString().ToLowerInvariant();
    private string UnitTitle => _granularity switch
    {
        Granularity.Hourly => "Hourly",
        Granularity.Daily => "Daily",
        Granularity.Weekly => "Weekly",
        Granularity.Monthly => "Monthly",
        _ => "Monthly"
    };
    private bool _loading;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _grid is not null)
        {
            await _grid.SetSortAsync(nameof(BridgeStatistic.Period), SortDirection.Descending, x => x.Period);
            await _grid.ExtendSortAsync(nameof(BridgeStatistic.Hour), SortDirection.Descending, x => x.Hour);
            await _grid.ExtendSortAsync(nameof(BridgeStatistic.BridgeNr), SortDirection.Ascending, x => x.BridgeNr);
        }
    }

    private async Task Refresh()
    {
        if (_start is null || _end is null || _end < _start)
        {
            return;
        }

        _showHour = _granularity == Granularity.Hourly;
        _showBridge = !_allBridges;

        var q0 =  DbContext.Statistics
            .Where(s => s.Category == "Bridge")
            .AsQueryable();
        if (_start != null)
        {
            var startDay = DateOnly.FromDateTime(_start.Value);
            q0 = q0.Where(s => s.Day >= startDay);
        }
        if (_end != null)
        {
            var endDay = DateOnly.FromDateTime(_end.Value);
            q0 = q0.Where(s => s.Day <= endDay);
        }
        IQueryable<BridgeStatistic> q = null!;
        if (_allBridges)
        {
            switch (_granularity)
            {
                case Granularity.Hourly:
                    q = q0
                        .GroupBy(s => new { s.Day, s.Hour })
                        .Select(s => new BridgeStatistic
                    {
                        BridgeNr = "*",
                        Period = s.Key.Day.ToString("yyyy-MM-dd"),
                        Hour = $"{s.Key.Hour:00}->{s.Key.Hour+1:00}",
                        CountOrdersIn = s.Sum(x => x.Counter01),
                        CountOrdersOut = s.Sum(x => x.Counter02),
                        CountOrdersRelocation = s.Sum(x => x.Counter03),
                        CountOrdersTotal = s.Sum(x => x.Counter01 + x.Counter02 + x.Counter03),
                        CountTiresIn = s.Sum(x => x.Counter11),
                        CountTiresOut = s.Sum(x => x.Counter12),
                        CountTiresRelocation = s.Sum(x => x.Counter13),
                        CountTiresTotal = s.Sum(x => x.Counter11 + x.Counter12 + x.Counter13)
                    });
                    break;
                case Granularity.Daily:
                    q = q0
                       .GroupBy(s => new { s.Day })
                       .Select(s => new BridgeStatistic
                    {
                        BridgeNr = "*",
                        Period = s.Key.Day.ToString("yyyy-MM-dd"),
                        Hour = "*",
                        CountOrdersIn = s.Sum(x => x.Counter01),
                        CountOrdersOut = s.Sum(x => x.Counter02),
                        CountOrdersRelocation = s.Sum(x => x.Counter03),
                        CountOrdersTotal = s.Sum(x => x.Counter01 + x.Counter02 + x.Counter03),
                        CountTiresIn = s.Sum(x => x.Counter11),
                        CountTiresOut = s.Sum(x => x.Counter12),
                        CountTiresRelocation = s.Sum(x => x.Counter13),
                        CountTiresTotal = s.Sum(x => x.Counter11 + x.Counter12 + x.Counter13)
                    });
                    break;
                case Granularity.Weekly:
                    var q1 = DbContext.ViewStatisticBridgePerWeekConsolidateds
                              .AsQueryable();
                    if (_start != null)
                    {   
                        int startYear, startWeek;
                        (startYear, startWeek) = _start.Value.GetIsoYearWeek();
                        q1 = q1.Where(s => s.Year > startYear || (s.Year == startYear && s.Week >= startWeek));
                    }
                    if (_end != null)
                    {
                        int endYear, endWeek;
                        (endYear, endWeek) = _end.Value.GetIsoYearWeek();
                        q1 = q1.Where(s => s.Year < endYear || (s.Year == endYear && s.Week <= endWeek));
                    }
                    q = q1.Select(s => new BridgeStatistic
                    {
                        BridgeNr = "*",
                        Period = $"{s.Year:0000}-{s.Week:00}",
                        Hour = "*",
                        CountOrdersIn = s.CountStacksIn,
                        CountOrdersOut = s.CountStacksOut,
                        CountOrdersRelocation = s.CountStacksRelocated,
                        CountOrdersTotal = s.CountStacksTotal,
                        CountTiresIn = s.CountTiresIn,
                        CountTiresOut = s.CountTiresOut,
                        CountTiresRelocation = s.CountTiresRelocated,
                        CountTiresTotal = s.CountTiresTotal
                    });
                    break;
                case Granularity.Monthly:
                    q = q0
                         .GroupBy(s => new { Year=s.Day.Year, Month=s.Day.Month })
                         .Select(s => new BridgeStatistic
                    {
                        BridgeNr = "*",
                        Period = $"{s.Key.Year:0000}-{s.Key.Month:00}",
                        Hour = "*",
                        CountOrdersIn = s.Sum(x => x.Counter01),
                        CountOrdersOut = s.Sum(x => x.Counter02),
                        CountOrdersRelocation = s.Sum(x => x.Counter03),
                        CountOrdersTotal = s.Sum(x => x.Counter01 + x.Counter02 + x.Counter03),
                        CountTiresIn = s.Sum(x => x.Counter11),
                        CountTiresOut = s.Sum(x => x.Counter12),
                        CountTiresRelocation = s.Sum(x => x.Counter13),
                        CountTiresTotal = s.Sum(x => x.Counter11 + x.Counter12 + x.Counter13)
                    });
                    break;
            }
        }
        else
        {
            switch (_granularity)
            {
                case Granularity.Hourly:
                    q = q0
                        .Select(s => new BridgeStatistic
                    {
                        BridgeNr = s.Element,
                        Period = s.Day.ToString("yyyy-MM-dd"),
                        Hour = $"{s.Hour:00}->{s.Hour + 1:00}",
                        CountOrdersIn = s.Counter01,
                        CountOrdersOut = s.Counter02,
                        CountOrdersRelocation = s.Counter03,
                        CountOrdersTotal = s.Counter01 + s.Counter02 + s.Counter03,
                        CountTiresIn = s.Counter11,
                        CountTiresOut = s.Counter12,
                        CountTiresRelocation = s.Counter13,
                        CountTiresTotal = s.Counter11 + s.Counter12 + s.Counter13
                    });
                    break;
                case Granularity.Daily:
                    q = q0
                        .GroupBy(s => new { s.Element, s.Day })
                        .Select(s => new BridgeStatistic
                    {
                        BridgeNr = s.Key.Element,
                        Period = s.Key.Day.ToString("yyyy-MM-dd"),
                        Hour = "*",
                        CountOrdersIn = s.Sum(x => x.Counter01),
                        CountOrdersOut = s.Sum(x => x.Counter02),
                        CountOrdersRelocation = s.Sum(x => x.Counter03),
                        CountOrdersTotal = s.Sum(x => x.Counter01 + x.Counter02 + x.Counter03),
                        CountTiresIn = s.Sum(x => x.Counter11),
                        CountTiresOut = s.Sum(x => x.Counter12),
                        CountTiresRelocation = s.Sum(x => x.Counter13),
                        CountTiresTotal = s.Sum(x => x.Counter11 + x.Counter12 + x.Counter13)
                    });
                    break;
                case Granularity.Weekly:
                    var q1 = DbContext.ViewStatisticBridgePerWeeks
                            .AsQueryable();
                    if (_start != null)
                    {
                        int startYear, startWeek;
                        (startYear, startWeek) = _start.Value.GetIsoYearWeek();
                        q1 = q1.Where(s => s.Year > startYear || (s.Year == startYear && s.Week >= startWeek));
                    }
                    if (_end != null)
                    {
                        int endYear, endWeek;
                        (endYear, endWeek) = _end.Value.GetIsoYearWeek();
                        q1 = q1.Where(s => s.Year < endYear || (s.Year == endYear && s.Week <= endWeek));
                    }
                    q = q1.Select(s => new BridgeStatistic
                    {
                        BridgeNr = s.BridgeNr,
                        Period = $"{s.Year:0000}-{s.Week:00}",
                        Hour = "*",
                        CountOrdersIn = s.CountStacksIn,
                        CountOrdersOut = s.CountStacksOut,
                        CountOrdersRelocation = s.CountStacksRelocated,
                        CountOrdersTotal = s.CountStacksTotal,
                        CountTiresIn = s.CountTiresIn,
                        CountTiresOut = s.CountTiresOut,
                        CountTiresRelocation = s.CountTiresRelocated,
                        CountTiresTotal = s.CountTiresTotal
                    });
                    break;
                case Granularity.Monthly:
                    q = q0
                        .GroupBy(s => new { s.Element, Year = s.Day.Year, Month = s.Day.Month })
                        .Select(s => new BridgeStatistic
                    {
                        BridgeNr = s.Key.Element,
                        Period = $"{s.Key.Year:0000}-{s.Key.Month:00}",
                        Hour = "*",
                        CountOrdersIn = s.Sum(x => x.Counter01),
                        CountOrdersOut = s.Sum(x => x.Counter02),
                        CountOrdersRelocation = s.Sum(x => x.Counter03),
                        CountOrdersTotal = s.Sum(x => x.Counter01 + x.Counter02 + x.Counter03),
                        CountTiresIn = s.Sum(x => x.Counter11),
                        CountTiresOut = s.Sum(x => x.Counter12),
                        CountTiresRelocation = s.Sum(x => x.Counter13),
                        CountTiresTotal = s.Sum(x => x.Counter11 + x.Counter12 + x.Counter13)
                    });
                    break;
            }
        }
        string sql = q.ToQueryString();
        _loading = true;
        StateHasChanged();
        await Task.Yield();
        try
        {
            _rows = await q.ToListAsync();
        }
        finally
        {
            _loading = false;
        }
    }

    private class BridgeStatistic
    {
        public string BridgeNr { get; set; } = default!;
        public string Period { get; set; } = default!;
        public string Hour { get; set; } = default!;
        public int? CountOrdersIn { get; set; }
        public int? CountOrdersOut { get; set; }
        public int? CountOrdersRelocation { get; set; }
        public int? CountOrdersTotal { get; set; }
        public int? CountTiresIn { get; set; }
        public int? CountTiresOut { get; set; }
        public int? CountTiresRelocation { get; set; }
        public int? CountTiresTotal { get; set; }
    }
}
