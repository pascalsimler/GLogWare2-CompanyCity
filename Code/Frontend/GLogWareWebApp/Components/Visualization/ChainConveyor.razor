<g transform="translate(@Fmt(X), @Fmt(Y))">
    <rect width="@Fmt(Length)" height="@Fmt(Height)" fill="#d1d5db" stroke="#374151" stroke-width="2" />
    @foreach (var cy in StrandFractions.Select(f => Height * f))
    {
        <line x1="4" y1="@Fmt(cy)" x2="@Fmt(Length - 4)" y2="@Fmt(cy)" stroke="#111827" stroke-width="6" />
        <line x1="4" y1="@Fmt(cy)" x2="@Fmt(Length - 4)" y2="@Fmt(cy)" stroke="#fbbf24" stroke-width="4" stroke-dasharray="6 4" />
        <circle cx="4" cy="@Fmt(cy)" r="5" fill="#4b5563" />
        <circle cx="@Fmt(Length - 4)" cy="@Fmt(cy)" r="5" fill="#4b5563" />
    }
    <text x="@Fmt(Length / 2)" y="@Fmt(Height + 16)" text-anchor="middle" font-family="Segoe UI, Arial" font-size="12" fill="#374151">@Name</text>
    @ChildContent
</g>

@code {
    [Parameter] public double X { get; set; }
    [Parameter] public double Y { get; set; }
    [Parameter] public double Length { get; set; } = 400;
    [Parameter] public double Height { get; set; } = 40;
    [Parameter] public string? Name { get; set; }
    // Strand positions across the width, as fractions of Height
    [Parameter] public double[] StrandFractions { get; set; } = [0.25, 0.75];
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private static string Fmt(double v) => v.ToString(System.Globalization.CultureInfo.InvariantCulture);
}
