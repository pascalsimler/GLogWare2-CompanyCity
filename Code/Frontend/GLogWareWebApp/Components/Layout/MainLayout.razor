@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation

<MudThemeProvider Theme="_current.Theme" @bind-IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="app-shell @_current.CssClass @(_navigationCollapsed ? "nav-collapsed" : null) @(_mobileNavigationOpen ? "nav-open" : null)" style="@_current.ShellStyle">
    @if (_mobileNavigationOpen)
    {
        <div class="nav-backdrop" @onclick="CloseMobileNavigation"></div>
    }
    <aside class="navigation-panel">
        <div class="brand">
            <MudIcon Icon="@Icons.Material.Filled.AllInbox" Size="Size.Large" />
            <div class="brand-copy">
                <strong>FlowOps</strong>
                <span>MFC + WMS</span>
            </div>
        </div>
        <NavMenu Compact="_navigationCollapsed" />
        <div class="site-indicator">
            <MudIcon Icon="@Icons.Material.Filled.LocationOn" />
            <div class="brand-copy">
                <strong>Plant DE-01</strong>
                <span>Online</span>
            </div>
        </div>
    </aside>

    <section class="workspace">
        <header class="title-bar">
            <div class="title-left">
                <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit"
                               OnClick="ToggleNavigation" aria-label="Toggle navigation" />
                <div>
                    <div class="application-title">Manufacturing &amp; Warehouse Control</div>
                    <div class="application-subtitle">@DateTime.Now.ToString("dddd, dd MMMM yyyy")</div>
                </div>
            </div>
            <div class="title-actions">
                <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                               Color="Color.Inherit" OnClick="@(() => _isDarkMode = !_isDarkMode)"
                               aria-label="@(_isDarkMode ? "Switch to light mode" : "Switch to dark mode")" />
                <MudMenu Icon="@Icons.Material.Filled.Palette" Color="Color.Inherit" AriaLabel="Select theme"
                         AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                    @foreach (var option in _themes)
                    {
                        var selected = option == _current;
                        <MudMenuItem Icon="@(selected ? Icons.Material.Filled.Check : null)"
                                     OnClick="@(() => _current = option)">@option.Name</MudMenuItem>
                    }
                </MudMenu>
                <MudBadge Content="3" Color="Color.Error" Overlap="true">
                    <MudIconButton Icon="@Icons.Material.Filled.NotificationsNone" Color="Color.Inherit" />
                </MudBadge>
                <MudAvatar Color="Color.Tertiary" Size="Size.Medium">PS</MudAvatar>
                <div class="user-copy">
                    <strong>Plant Supervisor</strong>
                    <span>Operations</span>
                </div>
            </div>
        </header>

<!--
        <div class="toolbar">
            <MudBreadcrumbs Items="_breadcrumbs" />
            <MudSpacer />
            <MudChip T="string" Icon="@Icons.Material.Filled.Circle" Color="Color.Success"
                     Size="Size.Small" Variant="Variant.Text">All systems operational</MudChip>
            <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" />
            <MudIconButton Icon="@Icons.Material.Filled.HelpOutline" Size="Size.Small" />
        </div>
-->

        <main class="page-content">
            @Body
        </main>

        <footer class="footer-bar">
            <span>FlowOps Control Center v1.0</span>
            <span>Last synchronized @DateTime.Now.ToString("HH:mm") · In-memory demonstration data</span>
        </footer>
    </section>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _navigationCollapsed;
    private bool _mobileNavigationOpen;
    private readonly List<BreadcrumbItem> _breadcrumbs =
    [
        new("Operations", href: null, disabled: true),
        new("Control center", href: null, disabled: true)
    ];

    private sealed record ThemeOption(string Name, MudTheme Theme, string ShellStyle, string? CssClass = null);

    // Shell (navigation panel + title bar) colors are driven by CSS variables defined in app.css
    private static readonly ThemeOption FlowOps = new("FlowOps", new MudTheme
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#155eef",
            Secondary = "#0e9384",
            Tertiary = "#7f56d9",
            Background = "#f4f6f9",
            Surface = "#ffffff",
            AppbarBackground = "#101828",
            TextPrimary = "#101828"
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#528bff",
            Secondary = "#2ed3b7",
            Tertiary = "#9e77ed",
            Background = "#0c111d",
            Surface = "#161b26",
            AppbarBackground = "#101828",
            TextPrimary = "#f5f5f6",
            LinesDefault = "#344054"
        },
        LayoutProperties = new LayoutProperties { DefaultBorderRadius = "10px" },
        Typography = new Typography
        {
            Default = new DefaultTypography { FontFamily = ["Inter", "sans-serif"] }
        }
    }, "");

    // SAP Fiori (Horizon-like): dark shell bar, light grey background, SAP blue accent, small corner radius
    private static readonly ThemeOption SapFiori = new("SAP Fiori", new MudTheme
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#0070f2",
            Secondary = "#5b738b",
            Tertiary = "#8d2a90",
            Info = "#0070f2",
            Success = "#107e3e",
            Warning = "#e9730c",
            Error = "#bb0000",
            Background = "#f5f6f7",
            Surface = "#ffffff",
            AppbarBackground = "#1d2d3e",
            TextPrimary = "#1d2d3e",
            TextSecondary = "#556b82",
            LinesDefault = "#d9d9d9"
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#4da3ff",
            Secondary = "#8fa6bd",
            Tertiary = "#c36ac6",
            Info = "#4da3ff",
            Success = "#3fb871",
            Warning = "#f0953a",
            Error = "#ff6b6b",
            Background = "#12171c",
            Surface = "#1b232b",
            AppbarBackground = "#1d2d3e",
            TextPrimary = "#eaecee",
            LinesDefault = "#3a4d61"
        },
        LayoutProperties = new LayoutProperties { DefaultBorderRadius = "4px" },
        Typography = new Typography
        {
            Default = new DefaultTypography { FontFamily = ["72", "72full", "Segoe UI", "Helvetica Neue", "Arial", "sans-serif"] }
        }
    }, "--shell-bg:#1d2d3e;--shell-border:#3a4d61;--shell-brand:#7cb5ff;--shell-muted:#a9b4be;" +
       "--shell-section:#8396a8;--shell-text:#e5e9ed;--shell-hover:#2b4057;--shell-active:#0070f2;",
       "theme-sap-fiori");

    private readonly ThemeOption[] _themes = [FlowOps, SapFiori];
    private ThemeOption _current = FlowOps;
    private bool _isDarkMode;

    private void ToggleNavigation()
    {
        _navigationCollapsed = !_navigationCollapsed;
        _mobileNavigationOpen = !_mobileNavigationOpen;
    }

    protected override void OnInitialized() => Navigation.LocationChanged += OnLocationChanged;

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _mobileNavigationOpen = false;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;

    private void CloseMobileNavigation() => _mobileNavigationOpen = false;
}
