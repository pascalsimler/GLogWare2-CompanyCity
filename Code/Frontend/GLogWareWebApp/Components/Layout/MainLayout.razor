    private readonly ThemeOption[] _themes = [FlowOps, SapFiori, Sahara, Gudel, Amazon, Ocean];
    private ThemeOption _current = FlowOps;
    private bool _isDarkMode;
    private bool _preferencesLoaded;

    // Persisted in localStorage so pages opened in a new tab keep the selected theme
    private async Task SelectThemeAsync(ThemeOption option)
    {
        _current = option;
        await SavePreferencesAsync();
    }

    private async Task ToggleDarkModeAsync()
    {
        _isDarkMode = !_isDarkMode;
        await SavePreferencesAsync();
    }

    private async Task SavePreferencesAsync()
    {
        if (_preferencesLoaded)
        {
            await Storage.SetItemAsStringAsync("flowops.theme", _current.Name);
            await Storage.SetItemAsync("flowops.dark", _isDarkMode);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            var name = await Storage.GetItemAsStringAsync("flowops.theme");
            if (await Storage.ContainKeyAsync("flowops.dark"))
            {
                _isDarkMode = await Storage.GetItemAsync<bool>("flowops.dark");
            }
            _current = _themes.FirstOrDefault(t => t.Name == name) ?? _current;
        }
        catch (Exception ex) when (ex is JSDisconnectedException or System.Text.Json.JsonException)
        {
            // Disconnected circuit or unreadable stored data: keep defaults
        }

        _preferencesLoaded = true;
        StateHasChanged();
    }

    private void ToggleNavigation()
    {
        _navigationCollapsed = !_navigationCollapsed;
        _mobileNavigationOpen = !_mobileNavigationOpen;
    }

    protected override void OnInitialized() => Navigation.LocationChanged += OnLocationChanged;

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _mobileNavigationOpen = false;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;

    private void CloseMobileNavigation() => _mobileNavigationOpen = false;
}
