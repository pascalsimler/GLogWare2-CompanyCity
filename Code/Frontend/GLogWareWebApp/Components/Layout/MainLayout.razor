@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation
@inject Blazored.LocalStorage.ILocalStorageService Storage

<MudThemeProvider Theme="_current.Theme" @bind-IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="app-shell @_current.CssClass @(_isDarkMode ? "app-dark" : null) @(_navigationCollapsed ? "nav-collapsed" : null) @(_mobileNavigationOpen ? "nav-open" : null)" style="@_current.ShellStyle">
    @if (_mobileNavigationOpen)
    {
        <div class="nav-backdrop" @onclick="CloseMobileNavigation"></div>
    }
    <aside class="navigation-panel">
        <div class="brand">
            <MudIcon Icon="@Icons.Material.Filled.AllInbox" Size="Size.Large" />
            <div class="brand-copy">
                <strong>FlowOps</strong>
                <span>MFC + WMS</span>
            </div>
        </div>
        <NavMenu Compact="_navigationCollapsed" />
        <div class="site-indicator">
            <MudIcon Icon="@Icons.Material.Filled.LocationOn" />
            <div class="brand-copy">
                <strong>Plant DE-01</strong>
                <span>Online</span>
            </div>
        </div>
    </aside>

    <section class="workspace">
        <header class="title-bar">
            <div class="title-left">
                <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit"
                               OnClick="ToggleNavigation" aria-label="Toggle navigation" />
                <div>
                    <div class="application-title">Manufacturing &amp; Warehouse Control</div>
                    <div class="application-subtitle">@DateTime.Now.ToString("dddd, dd MMMM yyyy")</div>
                </div>
            </div>
            <div class="title-actions">
                <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                               Color="Color.Inherit" OnClick="ToggleDarkModeAsync"
                               aria-label="@(_isDarkMode ? "Switch to light mode" : "Switch to dark mode")" />
                <MudMenu Icon="@Icons.Material.Filled.Palette" Color="Color.Inherit" AriaLabel="Select theme"
                         AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                    @foreach (var option in _themes)
                    {
                        var selected = option == _current;
                        <MudMenuItem Icon="@(selected ? Icons.Material.Filled.Check : null)"
                                     OnClick="@(() => SelectThemeAsync(option))">@option.Name</MudMenuItem>
                    }
                </MudMenu>
                <MudBadge Content="3" Color="Color.Error" Overlap="true">
                    <MudIconButton Icon="@Icons.Material.Filled.NotificationsNone" Color="Color.Inherit" />
                </MudBadge>
                <MudAvatar Color="Color.Tertiary" Size="Size.Medium">PS</MudAvatar>
                <div class="user-copy">
                    <strong>Plant Supervisor</strong>
                    <span>Operations</span>
                </div>
            </div>
        </header>

<!--
        <div class="toolbar">
            <MudBreadcrumbs Items="_breadcrumbs" />
            <MudSpacer />
            <MudChip T="string" Icon="@Icons.Material.Filled.Circle" Color="Color.Success"
                     Size="Size.Small" Variant="Variant.Text">All systems operational</MudChip>
            <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" />
            <MudIconButton Icon="@Icons.Material.Filled.HelpOutline" Size="Size.Small" />
        </div>
-->

        <main class="page-content">
            @Body
        </main>

        <footer class="footer-bar">
            <span>FlowOps Control Center v1.0</span>
            <span>Last synchronized @DateTime.Now.ToString("HH:mm") · In-memory demonstration data</span>
        </footer>
    </section>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

